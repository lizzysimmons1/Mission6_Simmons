@model List<movie>

@{
    ViewData["Title"] = "View Movie";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<table class="table table-striped">
    <thead>
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Category</th>
        <th>Lent To</th>
        <th>Copied To Plex</th>
        <th>Notes</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Year</td>
            <td>@movie.Director</td>
            <td>@movie.Rating</td>
            <td>@movie.Edited</td>
            <td>@(movie.Category != null ? movie.Category.CategoryName : "No Category")</td>
            <td>@movie.LentTo</td>
            <td>@movie.CopiedToPlex</td>
            <td>@movie.Notes</td>
            
            <td><a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@movie.MovieId">Edit</a></td>
            <td><a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@movie.MovieId">Delete</a></td>
        </tr>
    }
    </tbody>
</table>