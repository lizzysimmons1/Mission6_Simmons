@model movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h2>Are you sure you want to delete this movie?</h2>

<div>
    <strong>Title:</strong> @Model.Title
</div>
<div>
    <strong>Year:</strong> @Model.Year
</div>
<div>
    <strong>Director:</strong> @Model.Director
</div>
<div>
    <strong>Rating:</strong> @Model.Rating
</div>
<div>
    <strong>Edited:</strong> @(Model.Edited == true ? "Yes" : "No")

</div>
<div>
    <strong>Lent To:</strong> @Model.CopiedToPlex
</div>
<div>
    <strong>Notes:</strong> @Model.Notes
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("ViewMovie", "Home")" class="btn btn-secondary">Cancel</a>
</form>